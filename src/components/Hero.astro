---
import Icon from './Icon.astro';
import { hero, profile, socials, stats } from '@/data/site';

const links = socials.filter((s) => s.icon !== 'mail');

// The headline animates in word by word, so split it at build time.
const words = (text: string) => text.trim().split(/\s+/);
const before = words(hero.headline.before);
const highlight = words(hero.headline.highlight);
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="backdrop no-print" aria-hidden="true" data-hero-backdrop>
    <span class="aurora aurora-a"></span>
    <span class="aurora aurora-b"></span>
    <span class="grid"></span>
    <span class="grid grid-glow"></span>
  </div>

  <div class="container">
    <div class="copy">
      <p class="mono eyebrow rise">
        <span class="pulse" aria-hidden="true"></span>
        {hero.eyebrow}
      </p>

      <h1 id="hero-title">
        {before.map((word, i) => (
          <>
            <span class={`word w${i}`}>{word}</span>{' '}
          </>
        ))}
        <em>
          {highlight.map((word, i) => (
            <>
              <span class={`word w${before.length + i}`}>
                {word}
                {i === highlight.length - 1 && <span class="stop">{hero.headline.after}</span>}
              </span>
              {i < highlight.length - 1 && ' '}
            </>
          ))}
        </em>
      </h1>

      <p class="lede rise rise-3">{hero.lede}</p>

      <div class="cta rise rise-4 no-print">
        <a class="btn btn--primary" href="#work">
          View work
          <Icon name="arrow-down" size={16} />
        </a>
        <a class="btn" href={`mailto:${profile.email}`}>
          <Icon name="mail" size={16} />
          Get in touch
        </a>
        {profile.resumeUrl && (
          <a class="btn cv-phone" href={profile.resumeUrl} download>
            <Icon name="download" size={16} />
            Download CV
          </a>
        )}
        <ul class="social">
          {links.map((link) => (
            <li>
              <a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={link.label}>
                <Icon name={link.icon} size={20} />
              </a>
            </li>
          ))}
        </ul>
        <p class="hint" data-palette-hint hidden>
          Press <kbd data-palette-kbd>Ctrl K</kbd> to jump anywhere
        </p>
      </div>
    </div>

    <!-- The numbers behind the headline, presented as a passing test report:
         a full-width strip on desktop, a stacked card on small screens. -->
    <aside class="report rise rise-4" aria-label="Career in numbers" data-report data-spotlight>
      <header class="report-head no-print">
        <span class="mono">summary.report</span>
        <span class="status mono">
          <span class="dot" aria-hidden="true"></span>
          <span data-report-status>passed</span>
        </span>
      </header>

      <dl class="report-body">
        {stats.map((stat) => (
          <div class="row" data-report-row>
            <dt>{stat.label}</dt>
            <dd>
              <span class="state" aria-hidden="true">
                <Icon name="check" size={15} class="tick" />
              </span>
              <span data-count>{stat.value}</span>
            </dd>
          </div>
        ))}
      </dl>

      <footer class="report-foot mono no-print">
        <span>
          <span data-report-count>{stats.length}</span> of {stats.length} checks
        </span>
        <span class="bar" aria-hidden="true">
          <span data-report-bar></span>
        </span>
        <button type="button" class="rerun" data-report-rerun hidden>
          <Icon name="rerun" size={14} />
          Re-run
        </button>
      </footer>
    </aside>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block-start: clamp(3rem, 6.5vw, 5.5rem);
  }

  /* --- Backdrop: soft static glow + blueprint grid that lights up under the cursor */

  .backdrop {
    position: absolute;
    inset: calc(var(--header-h) * -1) 0 0;
    z-index: -1;
    overflow: clip;
  }

  .aurora {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
  }

  .aurora-a {
    top: -8rem;
    right: -6rem;
    width: 40rem;
    height: 28rem;
    background: var(--glow-a);
  }

  .aurora-b {
    top: 12rem;
    right: 24rem;
    width: 28rem;
    height: 22rem;
    background: var(--glow-b);
  }

  .grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 64px 64px;
    background-position: center top;
    mask-image: radial-gradient(ellipse 75% 85% at 85% 0%, #000 0%, transparent 72%);
  }

  /* Same grid in the accent colour, visible only in a circle around the pointer. */
  .grid-glow {
    --glow: color-mix(in oklab, var(--accent) 60%, transparent);
    background-image:
      linear-gradient(var(--glow) 1px, transparent 1px),
      linear-gradient(90deg, var(--glow) 1px, transparent 1px);
    mask-image: radial-gradient(
      15rem circle at var(--hx, -100rem) var(--hy, -100rem),
      #000 0%,
      transparent 100%
    );
    opacity: 0;
    transition: opacity 0.5s var(--ease);
  }

  .hero:global(.is-pointing) .grid-glow {
    opacity: 1;
  }

  @media (max-width: 52rem) {
    .aurora {
      filter: blur(60px);
    }

    .aurora-a {
      width: 22rem;
      height: 18rem;
    }

    .aurora-b {
      display: none;
    }
  }

  /* --- Copy --------------------------------------------------------------- */

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-block-end: 1.5rem;
    color: var(--text-muted);
  }

  .pulse {
    position: relative;
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
  }

  .pulse::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--accent);
    animation: ping 2.4s var(--ease) infinite;
  }

  @keyframes ping {
    0% {
      opacity: 0.7;
      scale: 1;
    }
    70%,
    100% {
      opacity: 0;
      scale: 3.2;
    }
  }

  /* The headline owns the full width of the page: three broad lines on a
     desktop instead of a tall, narrow column. */
  h1 {
    font-size: clamp(2.5rem, 1.4rem + 5.2vw, 5.25rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  h1 em {
    font-style: normal;
    color: var(--accent);
  }

  .word {
    display: inline-block;
    animation: word-in 0.9s var(--ease) both;
    animation-delay: calc(120ms + var(--w, 0) * 60ms);
  }

  @keyframes word-in {
    from {
      opacity: 0;
      translate: 0 0.35em;
      filter: blur(12px);
    }
  }

  /* Gradient ink on the highlighted words. The padding/margin pair keeps
     descenders inside the clipped background box. */
  em .word {
    padding-block-end: 0.14em;
    margin-block-end: -0.14em;
    background: linear-gradient(100deg, var(--accent) 10%, var(--accent-2) 110%);
    background-clip: text;
    color: transparent;
  }

  .stop {
    color: var(--text);
  }

  .w0 {
    --w: 0;
  }
  .w1 {
    --w: 1;
  }
  .w2 {
    --w: 2;
  }
  .w3 {
    --w: 3;
  }
  .w4 {
    --w: 4;
  }
  .w5 {
    --w: 5;
  }
  .w6 {
    --w: 6;
  }
  .w7 {
    --w: 7;
  }
  .w8 {
    --w: 8;
  }
  .w9 {
    --w: 9;
  }
  .w10 {
    --w: 10;
  }
  .w11 {
    --w: 11;
  }

  @media (forced-colors: active), print {
    em .word {
      background: none;
      color: var(--accent);
    }
  }

  .lede {
    max-width: 44rem;
    margin-block-start: 1.75rem;
    color: var(--text-muted);
    font-size: var(--step-1);
    line-height: 1.6;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-block-start: 2.25rem;
  }

  /* From tablet up the top bar carries "Download CV", so the hero's copy of
     the button only shows on phones, where the bar has no room for it. */
  @media (min-width: 47.51rem) {
    .cv-phone {
      display: none;
    }
  }

  .social {
    display: flex;
    gap: 0.25rem;
    margin-inline-start: 0.25rem;
  }

  .social a {
    display: grid;
    place-items: center;
    width: 2.875rem;
    height: 2.875rem;
    border-radius: 50%;
    color: var(--text-muted);
    transition:
      color 0.2s var(--ease),
      background-color 0.2s var(--ease),
      translate 0.2s var(--ease);
  }

  .social a:hover {
    background: var(--accent-soft);
    color: var(--text);
    translate: 0 -2px;
  }

  .hint {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-inline-start: auto;
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .hint[hidden] {
    display: none;
  }

  @media (hover: none), (max-width: 64rem) {
    .hint {
      display: none;
    }
  }

  /* --- Summary report ------------------------------------------------------
     Desktop: one strip — title and progress share the top bar, the figures sit
     side by side underneath. Small screens: a stacked card (head, rows, foot). */

  .report {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'head foot'
      'body body';
    margin-block-start: clamp(2.5rem, 5vw, 3.75rem);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: color-mix(in oklab, var(--surface-raised) 88%, transparent);
    backdrop-filter: blur(12px);
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .report-head,
  .report-foot {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.7rem 1.25rem;
    border-block-end: 1px solid var(--line);
    color: var(--text-muted);
    text-transform: none;
    letter-spacing: 0;
  }

  .report-head {
    grid-area: head;
  }

  .report-foot {
    grid-area: foot;
    white-space: nowrap;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    background: var(--ok-soft);
    color: var(--ok);
    text-transform: none;
    letter-spacing: 0;
    transition:
      background-color 0.3s var(--ease),
      color 0.3s var(--ease);
  }

  /* Blue while the checks run, green once they have passed. */
  .report:global(.is-running) .status {
    background: var(--accent-soft);
    color: var(--accent);
  }

  .dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: currentColor;
  }

  .report:global(.is-running) .dot {
    animation: blink 0.8s ease-in-out infinite alternate;
  }

  @keyframes blink {
    to {
      opacity: 0.25;
    }
  }

  .report-body {
    grid-area: body;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
  }

  /* One stat per cell: a large figure with what it measures underneath.
     The <dt> comes first in the markup, so the cell is reversed visually. */
  .row {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.6rem;
    padding: 1.5rem 1.25rem 1.6rem;
  }

  .row + .row {
    border-inline-start: 1px solid var(--line);
  }

  .row dt,
  .row dd {
    transition: opacity 0.3s var(--ease);
  }

  .row dt {
    max-width: 22rem;
    color: var(--text-muted);
    font-size: 0.9375rem;
    line-height: 1.45;
    text-wrap: balance;
  }

  .row dd {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-display-stack);
    font-size: var(--step-3);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    letter-spacing: -0.03em;
    white-space: nowrap;
  }

  /* Each check has three looks: pending (hollow ring), running (spinner), done (tick). */
  .state {
    position: relative;
    flex: none;
    display: grid;
    place-items: center;
    width: 15px;
    height: 15px;
    color: var(--ok);
  }

  .state::before {
    content: '';
    position: absolute;
    inset: 1px;
    border: 1.5px solid var(--line-strong);
    border-radius: 50%;
    opacity: 0;
  }

  .state :global(.tick) {
    transition:
      opacity 0.2s var(--ease),
      scale 0.4s cubic-bezier(0.3, 1.7, 0.5, 1);
  }

  .row:global(.is-pending) dt,
  .row:global(.is-pending) dd {
    opacity: 0.4;
  }

  .row:global(.is-pending) .state :global(.tick),
  .row:global(.is-running) .state :global(.tick) {
    opacity: 0;
    scale: 0.3;
  }

  .row:global(.is-pending) .state::before {
    opacity: 1;
  }

  .row:global(.is-running) .state::before {
    border-color: var(--accent);
    border-block-start-color: transparent;
    opacity: 1;
    animation: spin 0.6s linear infinite;
  }

  @keyframes spin {
    to {
      rotate: 1turn;
    }
  }

  .bar {
    flex: 1;
    min-width: 7rem;
    height: 4px;
    border-radius: 999px;
    background: var(--line);
    overflow: hidden;
  }

  .bar span {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
    transform: scaleX(var(--progress, 1));
    transform-origin: left;
    transition: transform 0.4s var(--ease);
  }

  .rerun {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 1.75rem;
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: transparent;
    font-size: 0.75rem;
    cursor: pointer;
    transition:
      border-color 0.2s var(--ease),
      color 0.2s var(--ease);
  }

  .rerun[hidden] {
    display: none;
  }

  .rerun:hover:not(:disabled) {
    border-color: var(--accent);
    color: var(--accent);
  }

  .rerun:disabled {
    cursor: progress;
    opacity: 0.5;
  }

  .rerun:disabled :global(svg) {
    animation: spin 0.9s linear infinite;
  }

  @media (max-width: 52rem) {
    .report {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'head'
        'body'
        'foot';
      max-width: 34rem;
    }

    .report-head {
      justify-content: space-between;
    }

    .report-foot {
      border-block-end: 0;
      border-block-start: 1px solid var(--line);
    }

    .bar {
      min-width: 2rem;
    }

    .report-body {
      grid-auto-flow: row;
      padding-inline: 1.25rem;
    }

    .row {
      padding-inline: 0;
    }

    .row + .row {
      border-inline-start: 0;
      border-block-start: 1px dashed var(--line);
    }
  }

  /* On paper the card flattens into a plain row of figures. */
  @media print {
    .hero {
      padding-block-start: 1.25rem;
    }

    .word {
      animation: none;
    }

    .report {
      display: block;
      max-width: none;
      margin-block-start: 1.5rem;
      border: 0;
      border-block: 1px solid var(--line);
      border-radius: 0;
      background: none;
      backdrop-filter: none;
      break-inside: avoid;
    }

    .report-body {
      grid-auto-flow: column;
      gap: 1rem;
      padding: 0.75rem 0;
    }

    .row {
      gap: 0.3rem;
      padding: 0;
    }

    .row + .row {
      border: 0;
    }

    .state {
      display: none;
    }
  }
</style>
