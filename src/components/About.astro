---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import portrait from '@/assets/portrait.jpg';
import { about, certifications, education, profile } from '@/data/site';
---

<section id="about" class="section container" aria-labelledby="about-title">
  <SectionHeading
    index="04"
    label="About"
    title="The person behind the commits."
    id="about-title"
  />

  <div class="layout">
    <figure class="portrait" data-reveal>
      <Picture
        src={portrait}
        formats={['avif', 'webp']}
        widths={[320, 480, 640, 960]}
        sizes="(max-width: 52rem) 90vw, 24rem"
        alt={`Portrait of ${profile.name}`}
        loading="lazy"
        decoding="async"
      />
      <figcaption class="mono">
        <Icon name="map-pin" size={14} />
        {profile.location}
      </figcaption>
    </figure>

    <div class="content">
      <div class="bio" data-reveal>
        {about.paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>

      <div class="facts">
        <section aria-labelledby="education-title" data-reveal>
          <h3 id="education-title" class="mono muted">
            Education
          </h3>
          <ul class="education">
            {education.map((item) => (
              <li>
                <p class="title">{item.title}</p>
                <p class="muted">
                  {item.institution} · {item.period}
                </p>
                {item.description && <p class="muted small">{item.description}</p>}
              </li>
            ))}
          </ul>
          {certifications.length > 0 && (
            <ul class="certs" aria-label="Certifications">
              {certifications.map((cert) => (
                <li class="chip">
                  {cert.url ? (
                    <a href={cert.url} target="_blank" rel="noopener noreferrer">
                      {cert.name}
                    </a>
                  ) : (
                    cert.name
                  )}
                </li>
              ))}
            </ul>
          )}
        </section>

        <section aria-labelledby="languages-title" data-reveal>
          <h3 id="languages-title" class="mono muted">
            Languages
          </h3>
          <dl class="languages">
            {about.languages.map((language) => (
              <div>
                <dt>{language.name}</dt>
                <dd class="muted">{language.level}</dd>
              </div>
            ))}
          </dl>
        </section>
      </div>
    </div>
  </div>
</section>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 24rem) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  .portrait {
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface);
  }

  .portrait :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
  }

  .portrait figcaption {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    background: var(--bg);
    color: var(--text);
    font-size: 0.75rem;
  }

  .bio {
    display: grid;
    gap: 1.25rem;
    max-width: 42rem;
    font-size: var(--step-1);
    line-height: 1.6;
  }

  .bio p:first-child {
    font-family: var(--font-display-stack);
    font-size: var(--step-2);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.015em;
  }

  .bio p + p {
    color: var(--text-muted);
  }

  .facts {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 2rem clamp(1.5rem, 4vw, 3rem);
    margin-block-start: clamp(2rem, 5vw, 3rem);
    padding-block-start: clamp(1.5rem, 4vw, 2.25rem);
    border-block-start: 1px solid var(--line);
  }

  h3 {
    margin-block-end: 1rem;
    font-family: var(--font-mono-stack);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .education {
    display: grid;
    gap: 1.25rem;
  }

  .title {
    font-weight: 600;
  }

  .small {
    margin-block-start: 0.3rem;
    font-size: 0.9375rem;
  }

  .certs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-block-start: 1.25rem;
  }

  .languages {
    display: grid;
  }

  .languages div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.6rem;
    border-block-end: 1px dashed var(--line);
  }

  .languages div:first-child {
    padding-block-start: 0;
  }

  .languages dt {
    font-weight: 550;
  }

  .languages dd {
    text-align: end;
    text-wrap: balance;
  }

  @media (max-width: 52rem) {
    .layout,
    .facts {
      grid-template-columns: minmax(0, 1fr);
    }

    .portrait {
      position: relative;
      top: auto;
      max-width: 22rem;
    }
  }
</style>
